# ─── 后端环境变量 ─────────────────────────────────────
ENV=dev                          # dev / prod
DEBUG=true

# PostgreSQL
POSTGRES_USER=tcalpha
POSTGRES_PASSWORD=dev
POSTGRES_DB=tcalpha
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://tcalpha:dev@localhost:5432/tcalpha
DATABASE_URL_SYNC=postgresql+psycopg2://tcalpha:dev@localhost:5432/tcalpha

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ArcticDB（本地嵌入式 LMDB）
ARCTIC_URI=lmdb://./data/arctic

# JWT（预留，前期可不配）
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# 默认用户（前期单用户模式，正式启用认证前临时占位）
DEFAULT_USER_ID=1

# CORS（开发期允许前端 vite 端口；prod 必须收紧到真实域名）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Basic Auth（Phase 6 上线必备；dev 可设 false，prod 必须 true）
AUTH_ENABLED=false
AUTH_USERNAME=admin
# 用 backend/scripts/gen_password_hash.py 生成 bcrypt hash 后粘贴这里
AUTH_PASSWORD_HASH=
# /docs /redoc /openapi.json 是否随鉴权一并保护（防止扫描）
AUTH_PROTECT_DOCS=true

# AI（OpenAI 兼容）
AI_API_BASE=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat

# AKShare
AKSHARE_RATE_LIMIT=2             # 每秒最大请求数（限流保护）

# 数据同步告警（下载最终失败时推飞书系统告警；留空则只记日志 + sync_logs 表）
SYNC_ALERT_WEBHOOK=
SYNC_ALERT_SECRET=

# 飞书机器人（用户级 webhook 走 PG notify_rules 表；此处仅可选的全局兜底）
# FEISHU_DEFAULT_WEBHOOK=
# FEISHU_DEFAULT_SECRET=
