# ─── TCAlpha 生产环境 .env 模板 ─────────────────────────────────────
# 拷贝为 .env 后填入真实值；.env 不入仓（已在 .gitignore）

ENV=prod
DEBUG=false

# ─── PostgreSQL（生产建议独立 DB 用户 + 强密码） ────────────────────
POSTGRES_USER=tcalpha
POSTGRES_PASSWORD=<请改成强密码>
POSTGRES_DB=tcalpha
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://tcalpha:<同上>@localhost:5432/tcalpha
DATABASE_URL_SYNC=postgresql+psycopg2://tcalpha:<同上>@localhost:5432/tcalpha

# ─── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── ArcticDB（生产路径，建议挂卷 /srv/tcalpha-data/arctic） ───────
ARCTIC_URI=lmdb:///srv/tcalpha-data/arctic

# ─── JWT（暂未用，预留） ──────────────────────────────────────────
JWT_SECRET=<openssl rand -hex 32>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# ─── 默认用户（单用户模式占位） ───────────────────────────────────
DEFAULT_USER_ID=1

# ─── CORS（必须收紧到真实域名！） ─────────────────────────────────
CORS_ORIGINS=https://tcalpha.example.com

# ─── Basic Auth（v0.6.0 必填） ─────────────────────────────────────
AUTH_ENABLED=true
AUTH_USERNAME=admin
# 用 backend/scripts/gen_password_hash.py 生成：
#   cd backend && uv run python scripts/gen_password_hash.py
AUTH_PASSWORD_HASH=<bcrypt hash here>
AUTH_PROTECT_DOCS=true

# ─── AI（DeepSeek 等 OpenAI 兼容） ─────────────────────────────────
AI_API_BASE=https://api.deepseek.com/v1
AI_API_KEY=<你的 DeepSeek key>
AI_MODEL=deepseek-chat

# ─── AKShare ───────────────────────────────────────────────────────
AKSHARE_RATE_LIMIT=2
